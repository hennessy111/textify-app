# ЮKassa credentials (получите в личном кабинете yookassa.ru)
YOOKASSA_SHOP_ID=ваш_shop_id_из_личного_кабинета
YOOKASSA_SECRET_KEY=ваш_secret_key_из_личного_кабинета

# URL вашего фронтенда (без слэша в конце)
PUBLIC_URL=https://your-frontend.vercel.app

# Порт сервера (для локальной разработки)
PORT=4000
